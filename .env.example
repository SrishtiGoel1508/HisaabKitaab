# Hisaab Kitaab Environment Configuration

# Server
PORT=5000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000

# Database (SQLite for local/Cloud Run persistent disk, PostgreSQL compatible)
DATABASE_URL="file:./dev.db"

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Storage
MAX_UPLOAD_SIZE_MB=10
STORAGE_DIR=./data/uploads

# Demo Business Configuration
DEMO_BUSINESS_ID=demo-kirana-store-001
DEMO_BUSINESS_NAME="Gupta Kirana & General Store"
